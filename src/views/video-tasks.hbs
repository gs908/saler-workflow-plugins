        <!-- 任务详情 -->
        <div id="sv-job-detail" style="display:none">
          <div style="font-size:15px;font-weight:600;margin-bottom:16px;color:#1e293b" id="sv-d-name"></div>
          <div class="ct-task-info">
            <div class="ct-info-row"><span class="ct-info-label">任务ID</span><span class="ct-info-value" id="sv-d-id"></span></div>
            <div class="ct-info-row"><span class="ct-info-label">业务ID</span><span class="ct-info-value" id="sv-d-execute-id"></span></div>
