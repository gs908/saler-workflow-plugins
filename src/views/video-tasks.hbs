<link rel="stylesheet" href="/stylesheets/claude-tasks.css" />

<style>
/* ── Tab 栏 ── */
.vt-tabs {
  display: flex; gap: 0; margin-bottom: 16px;
  border-bottom: 2px solid #e2e8f0;
}
.vt-tab {
  padding: 10px 24px; font-size: 14px; font-weight: 500;
  color: #64748b; cursor: pointer; border: none; background: none;
  border-bottom: 2px solid transparent; margin-bottom: -2px;
  font-family: inherit; transition: color 0.15s;
}
.vt-tab:hover { color: #1e293b; }
.vt-tab.active { color: #2563eb; border-bottom-color: #2563eb; font-weight: 600; }

/* ── Tab 内容面板 ── */
.vt-panel { display: none; }
.vt-panel.active { display: block; }

/* ── 字幕视频面板复用 ct- 样式 ── */
.sv-main {
  display: flex; gap: 16px;
  height: calc(100vh - 185px); min-height: 500px;
}
.sv-sidebar {
  width: 300px; min-width: 300px;
  background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
  display: flex; flex-direction: column; overflow: hidden;
}
.sv-sidebar-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 16px; border-bottom: 1px solid #e2e8f0;
  font-size: 12px; font-weight: 600; color: #64748b;
}
.sv-task-list { flex: 1; overflow-y: auto; }
.sv-item {
  padding: 12px 16px; cursor: pointer; border-bottom: 1px solid #f1f5f9;
  transition: background 0.15s;
}
.sv-item:hover { background: #f8faff; }
.sv-item.active { background: #eff6ff; border-left: 3px solid #2563eb; }
.sv-item-name {
  font-size: 13px; font-weight: 500; color: #1e293b;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px;
}
.sv-item-meta { display: flex; align-items: center; gap: 8px; }
.sv-detail {
  flex: 1; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
  overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px;
}

/* 进度条 */
.sv-progress-bg { height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 12px 0 4px; }
.sv-progress-fill { height: 100%; background: #2563eb; border-radius: 4px; transition: width 0.4s ease; }
.sv-progress-text { font-size: 12px; color: #64748b; }

/* 状态徽章 */
.badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 500; }
.badge-pending    { background: #fef9c3; color: #854d0e; }
.badge-processing { background: #dbeafe; color: #1d4ed8; }
.badge-completed  { background: #dcfce7; color: #166534; }
.badge-error      { background: #fee2e2; color: #991b1b; }

/* 新建表单 */
.sv-form { display: flex; flex-direction: column; gap: 14px; }
.sv-form label { font-size: 12px; color: #64748b; margin-bottom: 4px; display: block; }
.sv-form input[type=text], .sv-form input[type=file] {
  width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;
  font-size: 13px; font-family: inherit; color: #1e293b;
}
.sv-form input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
.sv-submit {
  padding: 10px; background: #2563eb; color: #fff; border: none; border-radius: 6px;
  font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
}
.sv-submit:hover { background: #1d4ed8; }
.sv-submit:disabled { background: #93c5fd; cursor: not-allowed; }

.sv-actions { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
.sv-btn {
  padding: 8px 18px; border-radius: 6px; font-size: 13px; font-weight: 500;
  cursor: pointer; border: none; font-family: inherit; text-decoration: none;
  display: inline-flex; align-items: center; gap: 6px;
}
.sv-btn-primary { background: #2563eb; color: #fff; }
.sv-btn-primary:hover { background: #1d4ed8; }
.sv-btn-play { background: #f0fdf4; color: #16a34a; border: 1px solid #86efac; }
.sv-btn-play:hover { background: #dcfce7; }

.sv-placeholder {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: #94a3b8; font-size: 14px; gap: 8px;
}
.sv-error-box {
  padding: 10px 14px; background: #fee2e2; border-radius: 6px;
  font-size: 13px; color: #991b1b; margin-top: 8px;
}
</style>

<div class="ct-page">
  <!-- 顶部标题 -->
  <div class="ct-header">
    <div class="ct-header-left">
      <h2 class="ct-title">视频任务管理</h2>
      <span class="ct-subtitle">Claude 生成视频 / 字幕合成视频</span>
    </div>
    <div class="ct-header-actions" id="header-actions">
      <!-- Claude tab 按钮 -->
      <div id="hdr-claude">
        <button class="ct-btn ct-btn-primary" id="btnNewTask">+ 新建任务</button>
        <button class="ct-btn ct-btn-ghost" id="btnRefresh">刷新列表</button>
      </div>
      <!-- 字幕视频 tab 按钮 -->
      <div id="hdr-subtitle" style="display:none">
        <button class="ct-btn ct-btn-primary" onclick="svShowForm()">+ 新建任务</button>
      </div>
    </div>
  </div>

  <!-- Tab 栏 -->
  <div class="vt-tabs">
    <button class="vt-tab active" onclick="switchTab('claude')">Claude 生成视频</button>
    <button class="vt-tab" onclick="switchTab('subtitle')">字幕合成视频</button>
  </div>

  <!-- Tab: Claude 任务（复用现有 hbs 结构） -->
