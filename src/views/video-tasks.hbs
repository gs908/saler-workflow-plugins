<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest/dist/hls.min.js"></script>
<script src="/javascripts/claude-tasks.js"></script>

<script>
// ══════════════════════════════════════════
//  Tab 切换
// ══════════════════════════════════════════
const SV_API = '/saler-plugins/api/subtitle-video';

function switchTab(tab) {
  document.querySelectorAll('.vt-tab').forEach((el, i) => {
    el.classList.toggle('active', (i === 0) === (tab === 'claude'));
  });
  document.getElementById('panel-claude').classList.toggle('active', tab === 'claude');
  document.getElementById('panel-subtitle').classList.toggle('active', tab === 'subtitle');
  document.getElementById('hdr-claude').style.display   = tab === 'claude'   ? '' : 'none';
  document.getElementById('hdr-subtitle').style.display = tab === 'subtitle' ? '' : 'none';

  if (tab === 'subtitle') {
    svLoadList();
    svStartPolling();
  }
}

// ══════════════════════════════════════════
//  字幕视频逻辑
// ══════════════════════════════════════════
let svJobs = [];
let svSelectedId = null;
let svPollTimer = null;

function svStartPolling() {
  if (svPollTimer) return;
  svPollTimer = setInterval(async () => {
    await svLoadList();
    if (svSelectedId) svUpdateDetail(svSelectedId);
    if (!svJobs.some(j => j.status === 'pending' || j.status === 'processing')) {
      clearInterval(svPollTimer); svPollTimer = null;
    }
  }, 3000);
}

async function svLoadList() {
  try {
    const res = await fetch(`${SV_API}/list`);
    svJobs = await res.json();
    svRenderList();
  } catch(e) { console.error('svLoadList', e); }
}

function svRenderList() {
  const el = document.getElementById('sv-list');
  document.getElementById('sv-count').textContent = svJobs.length;
  if (!svJobs.length) {
    el.innerHTML = '<div style="padding:40px 16px;text-align:center;color:#94a3b8;font-size:13px">暂无任务</div>';
    return;
  }
  el.innerHTML = svJobs.map(j => `
    <div class="sv-item ${j.id === svSelectedId ? 'active' : ''}" onclick="svSelect('${j.id}')">
      <div class="sv-item-name">${j.name || j.execute_id || j.id}</div>
      <div class="sv-item-meta">
        <span class="badge badge-${j.status}">${svStatusLabel(j.status)}</span>
        <span style="font-size:11px;color:#94a3b8">${svFmtTime(j.created_at)}</span>
      </div>
    </div>`).join('');
}

function svSelect(id) {
  svSelectedId = id;
  svRenderList();
  document.getElementById('sv-placeholder').style.display = 'none';
  document.getElementById('sv-new-form').style.display = 'none';
  document.getElementById('sv-job-detail').style.display = 'block';
  svUpdateDetail(id);
  svStartPolling();
}

function svUpdateDetail(id) {
  const job = svJobs.find(j => j.id === id);
  if (!job) return;
  document.getElementById('sv-d-name').textContent = job.name || job.execute_id || job.id;
  document.getElementById('sv-d-id').textContent = job.id;
  document.getElementById('sv-d-execute-id').textContent = job.execute_id || '-';
  document.getElementById('sv-d-status').innerHTML = `<span class="badge badge-${job.status}">${svStatusLabel(job.status)}</span>`;

  const pw = document.getElementById('sv-d-progress-wrap');
  const pct = svParseProgress(job.progress);
  if (job.status === 'processing' || job.status === 'pending') {
    pw.style.display = 'block';
    document.getElementById('sv-d-fill').style.width = pct + '%';
    document.getElementById('sv-d-progress-text').textContent = job.progress || '等待处理...';
  } else if (job.status === 'completed') {
    pw.style.display = 'block';
    document.getElementById('sv-d-fill').style.width = '100%';
    document.getElementById('sv-d-progress-text').textContent = '处理完成';
  } else {
    pw.style.display = 'none';
  }

  const errEl = document.getElementById('sv-d-error');
  if (job.status === 'error' && job.error) {
    errEl.style.display = 'block'; errEl.textContent = job.error;
  } else { errEl.style.display = 'none'; }

  const actions = document.getElementById('sv-d-actions');
  if (job.status === 'completed') {
    let btns = `<a class="sv-btn sv-btn-primary" href="${SV_API}/${job.id}/video" download>⬇ 下载视频</a>`;
    if (job.playlist_url || job.video_url) {
      btns += `<button class="sv-btn sv-btn-play" onclick="svOpenVideoModal('${job.playlist_url || ''}','${job.video_url || ''}')">▶ 播放视频</button>`;
    }
    actions.innerHTML = btns;
  } else { actions.innerHTML = ''; }
}

function svShowForm() {
  svSelectedId = null;
  svRenderList();
  document.getElementById('sv-placeholder').style.display = 'none';
  document.getElementById('sv-job-detail').style.display = 'none';
  document.getElementById('sv-new-form').style.display = 'block';
  document.getElementById('sv-submit-msg').textContent = '';
}

async function svSubmit() {
  const name  = document.getElementById('sv-f-name').value.trim();
  const audio = document.getElementById('sv-f-audio').files[0];
  const txt   = document.getElementById('sv-f-txt').files[0];
  const msg   = document.getElementById('sv-submit-msg');
  const btn   = document.getElementById('sv-btn-submit');
  if (!audio || !txt) { msg.style.color='#dc2626'; msg.textContent='请选择音频和字幕文件'; return; }
  btn.disabled = true; btn.textContent = '上传中...'; msg.textContent = '';
  const fd = new FormData();
  fd.append('audio', audio); fd.append('txt', txt);
  if (name) fd.append('name', name);
  try {
    const res  = await fetch(`${SV_API}/upload-and-async`, { method: 'POST', body: fd });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || '提交失败');
    msg.style.color = '#16a34a'; msg.textContent = `任务已创建`;
    btn.disabled = false; btn.textContent = '开始生成';
    document.getElementById('sv-f-name').value = '';
    document.getElementById('sv-f-audio').value = '';
    document.getElementById('sv-f-txt').value = '';
    await svLoadList();
    svSelect(data.jobId);
    svStartPolling();
  } catch(e) {
    msg.style.color = '#dc2626'; msg.textContent = e.message;
    btn.disabled = false; btn.textContent = '开始生成';
  }
}

function svStatusLabel(s) {
  return { pending:'等待', processing:'处理中', completed:'已完成', error:'失败' }[s] || s;
}
function svFmtTime(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  return `${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}
function svParseProgress(p) {
  if (!p) return 0;
  const m = p.match(/\((\d+\.?\d*)%\)/);
  if (m) return parseFloat(m[1]);
  if (p.includes('[INFO]')) return 2;
  if (p.includes('[完成]')) return 100;
  return 0;
}

// ── 字幕视频播放（复用 Claude 任务的视频弹框）──
function svOpenVideoModal(playlistUrl, videoUrl) {
  var playBtn = document.getElementById('btnPlayVideo');
  playBtn._playlistUrl = playlistUrl || null;
  playBtn._videoUrl    = videoUrl    || null;
  openVideoModal();
}

// ── 初始化：默认显示 Claude tab ──
// (claude-tasks.js DOMContentLoaded 先绑定好 btnNewTask/btnRefresh，这里无需再切)

</script>
