              <label>字幕文件 <span style="color:#dc2626">*</span></label>
              <input type="file" id="sv-f-txt" accept=".txt">
            </div>
            <button class="sv-submit" id="sv-btn-submit" onclick="svSubmit()">开始生成</button>
            <div id="sv-submit-msg" style="font-size:13px;text-align:center;min-height:18px"></div>
          </div>
