            <div class="ct-info-row"><span class="ct-info-label">任务 ID</span><span class="ct-info-value" id="infoTaskId">-</span></div>
            <div class="ct-info-row"><span class="ct-info-label">状态</span><span id="infoStatus">-</span></div>
            <div class="ct-info-row"><span class="ct-info-label">Skill</span><span class="ct-info-value" id="infoSkill">-</span></div>
            <div class="ct-info-row"><span class="ct-info-label">工作目录</span><span class="ct-info-value ct-mono" id="infoWorkDir">-</span></div>
            <div class="ct-info-row"><span class="ct-info-label">Prompt</span><span class="ct-info-value" id="infoPrompt">-</span></div>
            <div class="ct-info-row"><span class="ct-info-label">开始时间</span><span class="ct-info-value" id="infoStartTime">-</span></div>
            <div id="infoVideoArea" style="display:none;" class="ct-info-row">
              <span class="ct-info-label">视频</span>
              <span class="ct-info-value">
                <span id="infoSliceStatus"></span>
                <button class="ct-btn ct-btn-sm ct-btn-primary" id="btnPlayVideo" style="margin-left:8px;">▶ 播放</button>
