              <button class="ct-btn ct-btn-warning" id="btnRetryTask" style="display:none;">重新执行</button>
              <button class="ct-btn ct-btn-ghost" id="btnDeleteTask">删除任务</button>
            </div>
          </div>
          <div class="ct-output-header">
            <span>Claude 输出</span>
            <button class="ct-btn ct-btn-sm ct-btn-ghost" id="btnClearOutput">清空</button>
          </div>
          <div class="ct-output" id="outputArea">
            <div class="ct-output-content" id="outputContent"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab: 字幕视频 -->
  <div class="vt-panel" id="panel-subtitle">
    <div class="sv-main">
      <!-- 左侧列表 -->
      <div class="sv-sidebar">
        <div class="sv-sidebar-header">
          <span>任务列表</span>
          <span id="sv-count" style="color:#94a3b8">-</span>
        </div>
        <div class="sv-task-list" id="sv-list">
          <div style="padding:40px 16px;text-align:center;color:#94a3b8;font-size:13px">暂无任务</div>
        </div>
      </div>
      <!-- 右侧详情 -->
      <div class="sv-detail" id="sv-detail">
        <div class="sv-placeholder" id="sv-placeholder">
          <span style="font-size:40px">🎬</span>
          <span>选择左侧任务查看详情，或点击「新建任务」</span>
        </div>

        <!-- 新建表单 -->
        <div id="sv-new-form" style="display:none">
          <div style="font-size:15px;font-weight:600;margin-bottom:16px;color:#1e293b">新建字幕视频任务</div>
          <div class="sv-form">
            <div>
              <label>任务名称</label>
              <input type="text" id="sv-f-name" placeholder="例：20260413-张三-某银行会议">
