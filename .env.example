# Server Configuration
PORT=5699

# Application
NODE_ENV=development

# CORS (if needed)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Coze API Configuration
COZE_API_TOKEN=your_coze_api_token_here

# Coze Workflow IDs
COZE_MEETING_WORKFLOW_ID=7618205287124828170

# Coze 轮询配置
# 首次轮询延迟（分钟），默认 5
# COZE_POLLING_INITIAL_DELAY=5
# 后续轮询间隔（秒），默认 30
# COZE_POLLING_INTERVAL=30
# 最大轮询次数，默认 60
# COZE_POLLING_MAX_ATTEMPTS=60

# Claude Tasks SQLite DB 路径（可配置到其他磁盘）
# 默认不配置时使用项目根目录下的 data/claude-tasks.db
# CLAUDE_DB_PATH=D:/data/claude-tasks.db

# 售前分析报告的回调url
SALER_REPORT_CALLBACK_URL=http://localhost:5699/your-callback

# 售前分析报告回调密钥（可选，用于验证回调请求）
# SALER_REPORT_CALLBACK_SECRET=your_secret_key

# 售前分析报告回调超时（毫秒，默认 30000）
# SALER_REPORT_CALLBACK_TIMEOUT=30000

# Claude Tasks 默认回调地址（/async 接口不传 callbackUrl 时使用）
# CLAUDE_DEFAULT_CALLBACK_URL=http://localhost:3000/api/presales-video/workflow-callback

# Claude Tasks /async 接口默认值（不传对应字段时使用）
# CLAUDE_DEFAULT_PROMPT=根据报告内容，生成视频，使用默认主题
# CLAUDE_DEFAULT_SKILL=video-report-generator
# CLAUDE_DEFAULT_WORK_DIR=C:/work/projects

# mac需要单独配置PATH，否则无法执行bash命令
# PATH=/opt/homebrew/bin:/opt/homebrew/sbin

# ── 视频切片（src/services/video-slice/）─────────────────────────────────
# 存储模式：local（默认，本地磁盘）或 minio
# HLS_STORAGE_TYPE=local

# 切片临时目录（两种模式都需要，minio 模式上传后自动清理）
# HLS_OUTPUT_DIR=D:/data/hls

# local 模式：express.static 挂载路径 & playlist_url 前缀
# HLS_URL_PATH_PREFIX=/media/hls

# 切片时长（秒，默认 30）
# HLS_SEGMENT_TIME=30

# ffmpeg 路径（在 PATH 中时留空即可）
# FFMPEG_PATH=ffmpeg

# 下游回调超时（毫秒，默认 120000）
# SLICE_DOWNSTREAM_CALLBACK_TIMEOUT_MS=120000

# minio 模式配置（HLS_STORAGE_TYPE=minio 时生效）
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=report-video
# MINIO_PUBLIC_URL=http://localhost:9000
